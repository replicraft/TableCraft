# TableCraft UI: explicit offline row insertion.
insertion-title = New row
insertion-target = Table: { $table }
insertion-checking = Reading the fields for this new row…
insertion-intent-help = Choose Omitted, NULL or Value for editable fields. Omitted fields are not supplied; AutoNumber fields are read-only and stay omitted.
insertion-omitted = Omitted
insertion-null = NULL
insertion-value = Value
insertion-validating = Reviewing the complete new row…
insertion-reviewed = New row inputs reviewed. Omitted fields remain omitted.
insertion-row-count = Rows to insert: { $count }
insertion-apply = Apply new row to original file
insertion-review = Review new row
insertion-field-limit = This table has too many fields for the bounded new-row dialog.
insertion-input-limit = The new row exceeds the supported input size. Shorten its values before reviewing.
insertion-mock-help = Synthetic input only. No database file is opened or changed.
insertion-generated-value = (New)
insertion-auto-number-help = AutoNumber: assigned automatically when the new row is saved.
insertion-shortcut-help = Add a new record ({ $shortcut }).

insertion-inline-help = Edit the new record below. Tab moves between fields; Shift+Enter reviews it. Escape restores the current field, then cancels the record.

insertion-stale-draft = The source changed. Your input is retained; cancel this record before reopening or changing views.

insertion-field-input = { $field } input mode
