# TableCraft UI: inserción explícita de filas sin conexión.
insertion-title = Nueva fila
insertion-target = Tabla: { $table }
insertion-checking = Leyendo los campos de esta nueva fila…
insertion-intent-help = Elija explícitamente Omitido, NULL o Valor. Los campos omitidos no se proporcionan; no se suponen valores predeterminados ni generados.
insertion-omitted = Omitido
insertion-null = NULL
insertion-value = Valor
insertion-validating = Revisando la nueva fila completa…
insertion-reviewed = Entradas de la nueva fila revisadas. Los campos omitidos siguen omitidos.
insertion-row-count = Filas que se insertarán: { $count }
insertion-apply = Aplicar nueva fila al archivo original
insertion-review = Revisar nueva fila
insertion-field-limit = Esta tabla tiene demasiados campos para el diálogo limitado de nueva fila.
insertion-input-limit = La nueva fila supera el tamaño de entrada admitido. Acorte los valores antes de revisarla.
insertion-mock-help = Solo entrada sintética. No se abre ni modifica ningún archivo de base de datos.
