saved-query-type-binary = 二进制
saved-query-type-guid = GUID
saved-query-type-date = 日期/时间
saved-query-type-datetime-extended = 扩展日期/时间

saved-query-prompt-title = 输入参数值
saved-query-prompt-ok = 确定
saved-query-prompt-cancel = 取消
saved-query-prompt-validation = 带类型的值会在运行查询时进行验证。

# Saved query SQL close confirmation.
saved-query-close-title = 保存更改？
saved-query-close-question = 是否保存对查询“{ $name }”的更改？
saved-query-close-save = 保存
saved-query-close-discard = 放弃
saved-query-close-cancel = 取消
saved-query-close-unavailable = 当前无法保存此查询。
saved-query-close-stale = 查询草稿已更改。请取消并重新关闭。

# Saved query SQL editor.
saved-query-sql-unsaved = 有未保存的更改。请先保存再运行此查询。
saved-query-sql-source-changed = 已保存的定义发生了变化。您的 SQL 草稿已保留。

# Saved query save-status read-only reopening.
saved-query-save-retry-reopen = 重试重新打开
saved-query-save-return-draft = 返回 SQL 草稿
saved-query-read-cancellation-requested = 已请求取消。正在等待数据库读取停止。
