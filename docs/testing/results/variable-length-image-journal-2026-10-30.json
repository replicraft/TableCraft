{
  "date": "2026-10-30",
  "feature": "Additive V2 variable-length generic image transactions",
  "apis": [
    "ResizableDurableStorage",
    "prepare_resizable_expected",
    "PreparedResizableImage::commit",
    "PreparedResizableImage::rollback",
    "recover_resizable"
  ],
  "contract": {
    "format": "TCIMG002 + independent before/after little-endian u64 lengths + 32-byte SHA-256 + exact before + exact after; optional COMMIT02 plus same digest",
    "digest_domain": "Version magic, before length, after length, exact before and exact after. Equal concatenation with a different length split does not preserve the digest.",
    "limits": "Each image independently 0 through 64 MiB; checked record offsets; paid fallible image ownership, copies, reads/writes and work; bounded cancellation polls.",
    "storage": "New capability explicitly promises honest contiguous EOF-extending writes and resize with possible partial side effects. Complete image writes precede exact final resize/truncation; target sync precedes every marker byte.",
    "pending": "Actual length between image lengths; each actual byte must match its real before/after counterpart. No expected zero padding for absent tails. Restore before, truncate last, retain marker and journal; interrupted recovery restarts.",
    "committed": "Exact after length and bytes required; recovery writes neither target bytes nor length and only re-establishes barriers. Foreign/postcommit mixtures refuse.",
    "v1": "Original TCIMG001 encoder, transaction and recovery sources byte-exact. Existing fixed APIs stay fixed; new recovery delegates V1 unchanged, old recovery rejects V2.",
    "host": "Distinct exclusively owned correctly paired resources; durable namespace creation/cleanup, identity, authorization and blocking timeouts remain host obligations.",
    "engine_boundary": "No NativeEditPlan change, no engineering-preview conversion/promotion, no normal ACE/data-macro/journal activation."
  },
  "independent_records": {
    "cases": 9,
    "states": [
      "pending",
      "committed"
    ],
    "profiles": [
      "grow",
      "shrink",
      "equal",
      "empty before",
      "empty after",
      "empty both",
      "real zero payload",
      "same concatenation with differing length splits"
    ],
    "frozen_before_producer_authoring": true,
    "expected_repairs_after_api": false
  },
  "controls": [
    "Every complete record compared byte-for-byte with independent goldens",
    "Every truncation/byte corruption, every valid partial marker length, trailing bytes and oversized lengths",
    "All common-byte masks for bounded literals at every accepted target length",
    "Actual absent-tail versus real-zero mismatch and committed mismatch with zero writes/resizes",
    "Forced three-byte writes; failure before/after every callback and partial truncation side effects",
    "Independent target/journal unsynced survival/loss; interrupted pending rollback and committed barrier retry",
    "Exact/one-below Bytes/Steps and final callback cancellation",
    "Real ExclusiveFile grow/shrink/empty reopen and resize-before/partial/after-effect failure recovery",
    "Compile-fail guard prevents use with DurableStorage alone"
  ],
