  "findings": [
    "TDEF-only deletion hides the selected declaration but retains its two-property current live MR2 group as an orphan.",
    "Appending a new complete user MR2 snapshot without the selected group removes that live orphan while protecting all previous snapshots and database OFF body.",
    "Both representations retain all surviving field native numbers/IDs/storage/policies, the ID-only primary index and explicit stored OFF options.",
    "Active count falls independently of native-column and variable-slot high-water; no identity or variable ordinal compaction.",
    "All original dictionary keys are still used in these cases; unused-key dictionary behavior was not tested.",
    "The SDK empty ID property map observed after getter calls is not a raw persisted MR2 group; observed file bytes remain unchanged."
  ],
  "qualification_limits": [
    "Read compatibility of authored hypotheses only, not independent native writer output.",
    "No Microsoft Access execution, DROP Save byte comparison, UI warning timing/text or native garbage-collection qualification.",
    "Canonical empty ACE16 sources only; no populated-row/null-mask-tail, indexed-target, dependency repair, older-format write or subsequent schema/data mutation qualification.",
    "No engine candidate, intent, adapter, normal runtime or GUI DROP admission is introduced.",
    "Appending a new property snapshot is a chosen independent hypothesis, not evidence Access uses that physical save form."
  ],
