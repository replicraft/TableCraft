  "admission_contract": {
    "owners": [
      "GlobalFree",
      "OrdinaryOwned(definition)",
      "OrdinaryCandidate(definition)",
      "IndexOwned(definition,physical)",
      "ColumnOwned(definition,column)",
      "ColumnCandidate(definition,column)"
    ],
    "selection": "Every selected canonical owner must exist, selected identities must be unique, and every selected footprint is checked against all foreign catalog claims. No hardcoded mutable-role count.",
    "coverage": "All local table schemas, ordinary usage/optional hint, all parsed physical index owners, and complete current/historical LVAL declaration tails. Every declared physical slot must have a parsed logical owner; an orphan physical slot is an explicit Unsupported(RowLayout) coverage refusal.",
    "lval": "Exact existing five owners selected by caller. Ordinary/index/LVAL payload membership remains separate from metadata footprints; immutable original finalizer recensus retained. Foreign read-only grammar grants no writable membership/cell authority.",
    "resources": "All scans/allocations/checks paid; original per-table Reader ceilings preserved. Owner selection and deferred map-footprint protection alter some work/check ordering, so identical resource/cancellation boundaries are not claimed."
  },
