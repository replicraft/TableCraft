# TableCraft UI: inserción explícita de filas sin conexión.
insertion-title = Nueva fila
insertion-target = Tabla: { $table }
insertion-checking = Leyendo los campos de esta nueva fila…
insertion-intent-help = Elija Omitido, NULL o Valor para los campos editables. Los campos omitidos no se proporcionan; los de Autonumeración son de solo lectura y permanecen omitidos.
insertion-omitted = Omitido
insertion-null = NULL
insertion-value = Valor
insertion-validating = Revisando la nueva fila completa…
insertion-reviewed = Entradas de la nueva fila revisadas. Los campos omitidos siguen omitidos.
insertion-row-count = Filas que se insertarán: { $count }
insertion-apply = Aplicar nueva fila al archivo original
insertion-review = Revisar nueva fila
insertion-field-limit = Esta tabla tiene demasiados campos para el diálogo limitado de nueva fila.
insertion-input-limit = La nueva fila supera el tamaño de entrada admitido. Acorte los valores antes de revisarla.
insertion-mock-help = Solo entrada sintética. No se abre ni modifica ningún archivo de base de datos.
insertion-generated-value = (Nuevo)
insertion-auto-number-help = Autonumeración: se asigna automáticamente al guardar la nueva fila.
insertion-shortcut-help = Agregar un nuevo registro ({ $shortcut }).

insertion-inline-help = Edite el nuevo registro de abajo. Tab avanza entre campos; Mayús+Intro lo revisa. Esc restaura el campo actual y, al pulsarlo de nuevo, cancela el registro.

insertion-stale-draft = El origen ha cambiado. Se conserva su entrada; cancele este registro antes de volver a abrirlo o cambiar de vista.

insertion-field-input = Modo de entrada de { $field }

insertion-retained-help = La entrada original se conserva abajo para copiarla. Esta vista no guarda registros ni vuelve a intentar guardarlos.
insertion-retry-blocked = El resultado del guardado no permite reintentar este registro. Copie la entrada o descártela.
insertion-reopening = Verificando la base de datos original antes de volver a abrirla…
insertion-retry-original = Reabrir el original y editar
insertion-discard-retained = Descartar la entrada conservada

insertion-copy-input = Copiar entrada completa
insertion-preview-truncated = Vista previa abreviada. Use «{ insertion-copy-input }» para obtener el texto completo.

insertion-retained-schema-help = La tabla está guardada. La entrada original del registro se conserva abajo.
