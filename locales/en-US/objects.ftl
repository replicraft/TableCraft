# TableCraft UI: object workspace.

objects-open-refused = Cannot open this object while another operation is active or the workspace limit is reached.
objects-memory-limit = The open objects exceed the workspace memory limit. Close an object and try again.
objects-restore-refused = The previous workspace cannot be restored against this database.
objects-parameters-changed = Saved parameter inputs no longer match this query’s declarations.

objects-loading = Loading this object…
objects-not-loaded = This object has not been loaded.
objects-load-failed = This object could not be loaded.
objects-retry = Retry loading
objects-mock-load-error = Synthetic native read failure; no database was opened.

objects-read-identities-exhausted = Read request identities are exhausted. Restart TableCraft and reopen the database.
