# Native selection filtering; values remain runtime-owned.
filtering-equal = Equals selected value
filtering-not-equal = Does not equal selected value
filtering-is-null = Is Null
filtering-is-not-null = Is Not Null
filtering-clear-all = Clear All Filters
filtering-selection-help = Filter using the actual stored value. Different fields combine with AND; a new criterion replaces the previous criterion for that field.
filtering-toggle-help = Temporarily remove or reapply the retained filter.
filtering-filtered-count = Filtered: { $matched } of { $source } records
filtering-unfiltered-count = Unfiltered: { $source } records; retained filter matches { $matched }
filtering-applying-equal = Applying the Equals filter…
filtering-applying-not-equal = Applying the Does not equal filter…
filtering-loading = Loading the requested filter page…
filtering-clearing = Clearing all filters…
filtering-stale = The filter request no longer matches the current table or view.
filtering-invalid-result = The returned filter page, row identities or counts do not match this request.
filtering-record-range = That record number is outside this view.
filtering-mock-unavailable = Native filtering is unavailable in this synthetic preview. No records were filtered.
filtering-mock-membership = Synthetic membership only. No database was opened or filtered.
filtering-mock-error = Synthetic read failure. The previous filter and page are retained.
filtering-sort-help = Sort the complete native view while retaining filters and original record identities.
filtering-remove-sort-help = Remove the sort while retaining filter criteria.
filtering-source-count = Unfiltered: { $source } records
filtering-sort-ascending = Sorted by { $column } (ascending)
filtering-sort-descending = Sorted by { $column } (descending)
filtering-sorting = Sorting the native view…
filtering-sort-mock-unavailable = Native sorting is unavailable in this synthetic preview. No records were reordered.

filtering-field-title = Field filter
filtering-field-help = Choose a field comparison using native metadata. Applying reads the table; it does not write records.
filtering-field-comparison = Comparison
filtering-field-value = Value
filtering-field-second-value = Second value
filtering-field-apply = Apply filter
filtering-field-checking = Reading field metadata…
filtering-field-applying = Applying the field filter…
filtering-field-limit = Each text box accepts up to 65,535 characters. Nothing is truncated.
filtering-field-mock-error = Synthetic filter validation failed; no database was read or changed.
filtering-field-ansi89 = Text filters use ANSI-89 patterns: * and ? are wildcards; use brackets to match them literally. NULL is text; use Is Null for database NULL.
filtering-field-ansi92 = Text filters use ANSI-92 patterns: % and _ are wildcards; use brackets to match them literally. NULL is text; use Is Null for database NULL.
